mapscripts CedarForest_MapScripts {}

//
// SIGN EVENTS
//

script CedarForest_EventScript_TrailSign {
    msgbox("Cedar Trail\p
           {UP_ARROW} Cedar Rapids
           {DOWN_ARROW} Unnamed town", MSGBOX_SIGN)
}

script CedarForest_EventScript_RiverSign {
    msgbox("Cedar River
    “Bringing life to the fields and forests!”
    ", MSGBOX_SIGN)
}

script CedarForest_EventScript_ParkSign {
    msgbox("Cedar Park", MSGBOX_SIGN)
}

//
// NPC TALK EVENTS
//

script CedarForest_EventScript_TallGrassRanger {
    msgbox(format("Be careful in the tall grass.\pIn the tall grass multiple pok\emon can attack at the same time!"), MSGBOX_NPC)
    }

script CedarForest_EventScript_Chaser {
    msgbox(format("I'm gonna get you!"), MSGBOX_NPC)
}

script CedarForest_EventScript_Chasee {
    msgbox(format("You'll never catch me!"), MSGBOX_NPC)
}

//
// NPC TRAINER BATTLE EVENTS
//

script CedarForest_EventScript_Bug_Catcher_1 {
    trainerbattle_single(TRAINER_CEDAR_BUG_CATCHER_1,
        format("Check out all the neat bug pok\emon I've caught!"),
        format("Aren't all my bug pok\emon neat!"))
    msgbox(format("Did you know bug Pok\emon evolve super fast?"), MSGBOX_AUTOCLOSE)
}

script CedarForest_EventScript_Bug_Catcher_2 {
    trainerbattle_single(TRAINER_CEDAR_BUG_CATCHER_2,
        format("Be Careful of my bugs poison!"),
        format("Poison Pok\emon are neat!"))
    msgbox(format("Maybe I should become a ninja, I hear they use poison type pok\emon?"), MSGBOX_AUTOCLOSE)
}

script CedarForest_EventScript_Picnicker {
    trainerbattle_single(TRAINER_CEDAR_PICNICKER,
        format("The forest is so beautiful this time of year."),
        format("This forest is a lot less beautiful without my pok\emon."))
    msgbox(format("I just love the way the river winds through the forest!"), MSGBOX_AUTOCLOSE)
}

script CedarForest_EventScript_Twins_1 {
    trainerbattle_double(TRAINER_CEDAR_TWINS,
        format("I love the slide the best!"),
        format("It's my fault we lost."),
        format("You need at least two Pok\emon to battle us!"))
    msgbox(format("I wish I didn't let my sis down."), MSGBOX_AUTOCLOSE)
}

script CedarForest_EventScript_Twins_2 {
    trainerbattle_double(TRAINER_CEDAR_TWINS,
        format("The sandbox is my favorite!"),
        format("We would have won if my sister was better."),
        format("You need at least two Pok\emon to battle us!"))
    msgbox(format("I still love my sis even if she isn't very good at battles."), MSGBOX_AUTOCLOSE)
}

script CedarForest_EventScript_Ranger_1 {
    trainerbattle_single(TRAINER_CEDAR_RANGER_1,
    format("Don't you know it's dangerous to leave the path?"),
    format("You are definitely strong enough to explore the rest of the forest."))
    msgbox(format("Be careful. Sometimes strong pokemon appear off the path."), MSGBOX_AUTOCLOSE)
}

script CedarForest_EventScript_Ranger_2 {
    trainerbattle_single(TRAINER_CEDAR_RANGER_2,
    format("How did you find this place?"),
    format("There's an abandoned cistern deeper in the forest."))
    msgbox(format("The pokemon deeper in the forest are much stronger."), MSGBOX_AUTOCLOSE)
}

script CedarForest_EventScript_Lass {
    trainerbattle_single(TRAINER_CEDAR_LASS,
    format("I just love how beautiful the river looks here!"),
    format("Don't you think the way it winds is just entrancing?"))
    msgbox(format("I wish I could stay here all day."), MSGBOX_AUTOCLOSE)
}

script CedarForest_EventScript_Fisherman {
    trainerbattle_single(TRAINER_CEDAR_FISHERMAN,
    format("There's nothing better than relaxing with a rod and the water."),
    format("I don't mind losing, just means I can get back to fishing faster."))
    msgbox(format("I wonder what I'll fish up next?"), MSGBOX_AUTOCLOSE)
}

//
// RIVAL EVENTS
//

script CedarForest_EventScript_RivalTrigger_1 {
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_CEDAR_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_CEDAR_RIVAL, CedarForest_Movement_RivalApproach_1)
    waitmovement(0)
    msgbox(format("{PLAYER}! Took you long enough. Let's see whose partner is stronger!"))
    trainerbattle_no_intro(TRAINER_RIVAL_CEDAR_FOREST_CHIKORITA, CedarForest_Text_RivalDefeat)
    //switch (var(VAR_STARTER_MON)) {
    //    case 0:
    //        trainerbattle_no_intro(TRAINER_RIVAL_CEDAR_FOREST_TORCHIC, CedarForest_Text_RivalDefeat)
    //    case 1:
    //        trainerbattle_no_intro(TRAINER_RIVAL_CEDAR_FOREST_QUAXLY, CedarForest_Text_RivalDefeat)
    //    default:
    //        trainerbattle_no_intro(TRAINER_RIVAL_CEDAR_FOREST_CHIKORITA, CedarForest_Text_RivalDefeat)
    //}
    msgbox(format("Fine, you win this time. See you in Cedar Rapids!"))
    closemessage
    applymovement(LOCALID_CEDAR_RIVAL, moves(walk_fast_up * 6))
    waitmovement(0)
    removeobject(LOCALID_CEDAR_RIVAL)
    setflag(FLAG_HIDE_CEDAR_FOREST_RIVAL)
    setvar(VAR_CEDAR_FOREST_STATE, 1)
    releaseall
}

script CedarForest_EventScript_RivalTrigger_2 {
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_CEDAR_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_CEDAR_RIVAL, CedarForest_Movement_RivalApproach_2)
    waitmovement(0)
    msgbox(format("{PLAYER}! Took you long enough. Let's see whose partner is stronger!"))
    trainerbattle_no_intro(TRAINER_RIVAL_CEDAR_FOREST_CHIKORITA, CedarForest_Text_RivalDefeat)
    //switch (var(VAR_STARTER_MON)) {
    //    case 0:
    //        trainerbattle_no_intro(TRAINER_RIVAL_CEDAR_FOREST_TORCHIC, CedarForest_Text_RivalDefeat)
    //    case 1:
    //        trainerbattle_no_intro(TRAINER_RIVAL_CEDAR_FOREST_QUAXLY, CedarForest_Text_RivalDefeat)
    //    default:
    //        trainerbattle_no_intro(TRAINER_RIVAL_CEDAR_FOREST_CHIKORITA, CedarForest_Text_RivalDefeat)
    //}
    msgbox(format("Fine, you win this time. See you in Cedar Rapids!"))
    closemessage
    applymovement(LOCALID_CEDAR_RIVAL, moves(walk_fast_up * 6))
    waitmovement(0)
    removeobject(LOCALID_CEDAR_RIVAL)
    setflag(FLAG_HIDE_CEDAR_FOREST_RIVAL)
    setvar(VAR_CEDAR_FOREST_STATE, 1)
    releaseall
}

text CedarForest_Text_RivalDefeat {
    format("What?! I lost?")
}

movement CedarForest_Movement_RivalApproach_1 {
    face_player
}

movement CedarForest_Movement_RivalApproach_2 {
    walk_right
    face_player
}